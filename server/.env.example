PORT=8787
DATABASE_PATH=./data/tether.db
# Required in production: long random string (e.g. `openssl rand -base64 48`)
JWT_SECRET=
PUBLIC_BASE_URL=http://localhost:8787
# APNs (leave unset to use the logging mock transport)
APNS_KEY_P8=./AuthKey_XXXXXXXXXX.p8   # PEM contents or a file path
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=YYYYYYYYYY
APNS_TOPIC=com.newwestsite.tether
APNS_ENV=sandbox                      # sandbox | production
# Optional
ALLOW_REGISTRATION=true
TRUST_PROXY=false
LOG_LEVEL=info
ADMIN_DIST=../admin/dist
