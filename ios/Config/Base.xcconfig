// Base.xcconfig — shared by Debug and Release. Per-developer overrides go in
// Local.xcconfig (git-ignored; copy Local.xcconfig.example).

// Reverse-DNS prefix for every bundle ID: $(BUNDLE_ID_PREFIX).tether[.monitor|...]
BUNDLE_ID_PREFIX = com.newwestsite

// Default server URL baked into Info.plist (TetherDefaultServerURL).
// NOTE: xcconfig treats "//" as a comment, so the scheme separator is escaped via $().
TETHER_SERVER_URL = https:/$()/tether.example.com

// Apple Developer Team ID (10 chars). Set in Local.xcconfig.
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 5.10
TARGETED_DEVICE_FAMILY = 1
SDKROOT = iphoneos

// Optional local overrides (silently ignored if the file does not exist).
#include? "Local.xcconfig"
