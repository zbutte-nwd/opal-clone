// Copy to Local.xcconfig (git-ignored) and edit. scripts/bootstrap-mac.sh does this for you.

// Your Apple Developer Team ID (developer.apple.com -> Membership).
DEVELOPMENT_TEAM = ABCDE12345

// Must be a prefix you can register bundle IDs + App Group under.
BUNDLE_ID_PREFIX = com.newwestsite

// Server the app talks to by default (note the $() trick for the "//").
// For a real device on your LAN use e.g. http:/$()/192.168.1.20:8787
TETHER_SERVER_URL = https:/$()/tether.example.com
